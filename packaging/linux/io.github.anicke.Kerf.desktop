[Desktop Entry]
Type=Application
Name=Kerf
GenericName=Audio Editor
Comment=Edit audio precisely and turn live recordings into finished albums
Exec=kerf %F
Icon=io.github.anicke.Kerf
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;
Keywords=audio;editor;wave;flac;split;album;concert;
MimeType=application/x-kerf-project;audio/x-wav;audio/wav;audio/flac;audio/x-flac;audio/mpeg;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/aiff;audio/x-aiff;audio/mp4;
StartupWMClass=io.github.anicke.Kerf
